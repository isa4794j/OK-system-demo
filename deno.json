{
  "name": "ok-system",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch --env-file --allow-net --allow-env --allow-read main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "check": "deno check main.ts lib/",
    "test": "deno test --allow-net=127.0.0.1 --allow-env=NLK_API_KEY,DATA4LIBRARY_API_KEY,AUTH_ENFORCE --allow-read=api/mod.ts,api/accounts.ts,api/staff.ts lib/ db/ api/",
    "demo:anon": "deno run lib/anonymize_demo.ts",
    "demo:ai": "deno run --env-file --allow-env --allow-net lib/ai_demo.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "unstable": ["cron"],
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.123.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.58.0",
    "postgres": "npm:postgres@^3.4.5",
    "@std/http": "jsr:@std/http@^1.0.20",
    "@std/http/file-server": "jsr:@std/http@^1.0.20/file-server",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/assert": "jsr:@std/assert@^1.0.14"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["web/", "CLAUDE.md", "docs/"]
  },
  "lint": {
    "exclude": ["web/"]
  }
}

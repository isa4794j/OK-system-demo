# 환경변수 (실제 키가 들어있음 — 절대 커밋 금지)
.env
.env.*
!.env.example

# Deno
.deno/
node_modules/
# deno vendor 가 만드는 자리. 뿌리에 붙여 둔다 —
# 그냥 vendor/ 로 두면 web/assets/vendor(남이 만든 파일을 넣어 둔 자리)까지 빠진다.
/vendor/

# 에디터 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 로그, 임시 파일
*.log
tmp/

# 로컬 개발 도구 설정 (미리보기 서버 실행 정보 — 사람마다 다르다)
.claude/

# 검증 도구 결과(세션 토큰이 들어 있다 — 절대 커밋 금지)
db/tools/verify/out/

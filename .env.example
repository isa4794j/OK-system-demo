# OK 시스템 데모 환경변수 견본 — 값을 채워 Deno Deploy 프로젝트 환경변수로 등록하세요
SUPABASE_URL=            # Supabase 프로젝트 URL (https://<ref>.supabase.co)
SUPABASE_KEY=            # service_role 키 (서버 전용 — 프론트로 내려보내지 않습니다)
ANTHROPIC_API_KEY=       # console.anthropic.com 에서 발급 (유료 — 데모는 지출 한도를 걸어 두세요)
NLK_API_KEY=             # 국립중앙도서관 오픈API (무료 발급)
DATA4LIBRARY_API_KEY=    # 도서관 정보나루 (무료 발급)
AUTH_ENFORCE=true        # 로그인·등급 잠금 (반드시 true, 비상 되돌리기만 warn)

# Deno Deploy 에서는 두지 않습니다 — PORT(기본 8000), ANALYSIS_SWEEP(Deno.cron 이 자동)
# PostgreSQL 에 직결할 때만 — DATABASE_URL(있으면 SUPABASE_* 대신 이쪽을 씁니다), DATABASE_POOL_MAX
# 환경변수 표는 docs/설치순서.md 의 "3. 환경변수" 참고
